# Copie para .env e ajuste a conexao. scripts/executar.ps1 carrega este arquivo.
# Variaveis ja definidas no terminal tem prioridade. Nao versione o .env.
SPRING_PROFILES_ACTIVE=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/fluxoos
DATABASE_USER=fluxoos
DATABASE_PASSWORD=troque-por-uma-senha-longa
# HTTP local. Em producao com HTTPS, use true.
COOKIE_SECURE=false
# Limites por instancia: novas sessoes sao recusadas ao atingir o limite.
MAX_SESSOES=20
# Cinco erros por usuario em 15 minutos bloqueiam novos logins por 5 minutos.
LOGIN_MAX_ERROS=5
LOGIN_JANELA_MINUTOS=15
LOGIN_BLOQUEIO_MINUTOS=5
# Protecao adicional para tentativas distribuidas por nomes no mesmo IP.
LOGIN_MAX_ERROS_IP=30
LOGIN_MAX_IDENTIFICADORES=10000
SEGURANCA_LIMPEZA_MS=60000
# Senha do admin da aplicacao, exigida somente se o banco nao tiver usuarios.
# O script pede essa senha sem exibi-la; nao e necessario salva-la aqui.
# BOOTSTRAP_PASSWORD=defina-a-senha-inicial-do-admin
# SERVER_ADDRESS=0.0.0.0
# Docker Compose tambem le DATABASE_PASSWORD deste arquivo.
# Execucao direta com java/mvnw nao carrega .env: exporte as variaveis.
